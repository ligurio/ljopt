From 0640c9d9a1fe7b13ab704b072b06012707c22024 Mon Sep 17 00:00:00 2001
From: Churkin Aleksey <lekhachurkin@gmail.com>
Date: Mon, 9 Feb 2026 19:31:05 +0300
Subject: [PATCH] patch some internal to expose snapshot pc in

---
 src/lib_jit.c | 38 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/src/lib_jit.c b/src/lib_jit.c
index 9f870f68..689a23bb 100644
--- a/src/lib_jit.c
+++ b/src/lib_jit.c
@@ -288,6 +288,44 @@ static const char *const jit_trlinkname[] = {
   "interpreter", "return", "stitch"
 };
 
+/* Get detailed table information including hmask, asize, etc. */
+LJLIB_CF(jit_util_tablesize)
+{
+  GCtab *t = (GCtab *)lj_lib_checktab(L, 1);
+  
+  /* Just push both values directly */ 
+  lua_pushinteger(L, (int)t->hmask);
+  lua_pushinteger(L, (int)t->asize);
+  
+  return 2;  /* Return 2 values */
+}
+
+/* local info = jit.util.snappc(tr) */
+LJLIB_CF(jit_util_snappc)
+{
+  int snapno = lj_lib_checkint(L, 2);
+
+  GCtrace *T = jit_checktrace(L);
+  if (snapno < 0 || snapno >= T->nsnap) {
+    lua_pushnil(L);  // Invalid snapshot number
+    return 1;
+  }
+  SnapShot *snap = &T->snap[snapno];
+  SnapEntry *map = &T->snapmap[snap->mapofs];
+  const BCIns *pc = snap_pc(&map[snap->nent]);
+  const BCIns *bc_base = pc;
+  // Find beginning of the function.
+  // Snapshots will be matched by offset from this beginning.
+  while (bc_op(*bc_base) < BC_FUNCF) {
+    bc_base--;
+  }
+  int offset = (int)(pc - bc_base);  // Instruction offset
+
+  // Return as Lua number (instruction offset)
+  lua_pushinteger(L, offset);
+  return 1;
+}
+
 /* local info = jit.util.traceinfo(tr) */
 LJLIB_CF(jit_util_traceinfo)
 {
-- 
2.43.0

