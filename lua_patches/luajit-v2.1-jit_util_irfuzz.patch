+/* -- IR fuzzing harness (ljopt) ------------------------------------------ */
+
+/* Operand kinds for jit.util.irfuzz() instruction descriptors. */
+enum {
+  IRFUZZ_OPND_NONE,   /* No operand (op field is 0). */
+  IRFUZZ_OPND_REF,    /* Reference to an earlier stream instruction. */
+  IRFUZZ_OPND_KINT,   /* int32 constant, interned via lj_ir_kint(). */
+  IRFUZZ_OPND_KNUM,   /* FP constant, interned via lj_ir_knum(). */
+  IRFUZZ_OPND_LIT,    /* Raw literal (slot number, mode bits, ...). */
+  IRFUZZ_OPND_KINT64, /* int64 constant, interned via lj_ir_kint64(). */
+  IRFUZZ_OPND_KSTR    /* string constant, interned via lj_ir_kstr(). */
+};
+
+/* Pseudo-trace initialization, mirroring trace_start() and
+** lj_record_setup(), without a bytecode prototype. J->cur.traceno
+** stays 0 so the GC never traverses the pseudo-trace.
+*/
+static void irfuzz_reset(jit_State *J)
+{
+  int i;
+  memset(&J->cur, 0, sizeof(GCtrace));
+  J->cur.nins = J->cur.nk = REF_BASE;
+  J->cur.ir = J->irbuf;
+  J->cur.snap = J->snapbuf;
+  J->cur.snapmap = J->snapmapbuf;
+  J->mergesnap = 0;
+  J->needsnap = 0;
+  J->bcskip = 0;
+  J->guardemit.irt = 0;
+  J->postproc = LJ_POST_NONE;
+  lj_resetsplit(J);
+  memset(J->chain, 0, sizeof(J->chain));
+  memset(J->slot, 0, sizeof(J->slot));
+#ifdef LUAJIT_ENABLE_TABLE_BUMP
+  memset(J->rbchash, 0, sizeof(J->rbchash));
+#endif
+  memset(J->bpropcache, 0, sizeof(J->bpropcache));
+  J->scev.idx = REF_NIL;
+  setmref(J->scev.pc, NULL);
+  J->baseslot = 1+LJ_FR2;
+  J->base = J->slot + J->baseslot;
+  J->maxslot = 0;
+  J->framedepth = 0;
+  J->retdepth = 0;
+  /* Emit instructions for fixed references. Also triggers initial IR alloc. */
+  lj_ir_set(J, IRT(IR_BASE, IRT_PGC), 0, 0);
+  lj_ir_emit(J);
+  for (i = 0; i <= 2; i++) {
+    IRIns *ir = &J->cur.ir[REF_NIL-i];
+    ir->i = 0;
+    ir->t.irt = (uint8_t)(IRT_NIL+i);
+    ir->o = IR_KPRI;
+    ir->prev = 0;
+  }
+  J->cur.nk = REF_TRUE;
+}
+
+/* Resolve one operand descriptor to a TRef/literal for the fold engine.
+** valtab is the absolute stack index of the operand value array.
+*/
+static TRef irfuzz_operand(lua_State *L, jit_State *J, TRef *map,
+			   int kind, int valtab, int i)
+{
+  lua_Number v;
+  lua_rawgeti(L, valtab, i);
+  v = lua_tonumber(L, -1);
+  lua_pop(L, 1);
+  switch (kind) {
+  case IRFUZZ_OPND_NONE:
+    return 0;
+  case IRFUZZ_OPND_REF: {
+    int g = (int)v;
+    if (g < 1 || g >= i)
+      lj_err_callermsg(L, "irfuzz: operand must reference an earlier insn");
+    return map[g-1];
+  }
+  case IRFUZZ_OPND_KINT:
+    return lj_ir_kint(J, (int32_t)v);
+  case IRFUZZ_OPND_KINT64:
+    /* v arrives as a double: exact for every fold-trigger i64
+    ** constant (all small); constants above 2^53 are not
+    ** representable and must not be requested here. */
+    return lj_ir_kint64(J, (uint64_t)(int64_t)v);
+  case IRFUZZ_OPND_KNUM:
+    return lj_ir_knum(J, v);
+  case IRFUZZ_OPND_LIT:
+    return (TRef)(uint32_t)v;
+  case IRFUZZ_OPND_KSTR: {
+    /* Value is a Lua string, interned as a GCstr constant. This
+    ** is the only operand kind whose value is not a number, so it
+    ** is read fresh here rather than via the lua_tonumber above. */
+    const char *str;
+    size_t len;
+    TRef r;
+    lua_rawgeti(L, valtab, i);
+    str = lua_tolstring(L, -1, &len);
+    if (!str)
+      lj_err_callermsg(L, "irfuzz: KSTR operand must be a string");
+    r = lj_ir_kstr(J, lj_str_new(L, str, len));
+    lua_pop(L, 1);
+    return r;
+  }
+  default:
+    lj_err_callermsg(L, "irfuzz: bad operand kind");
+    return 0;  /* unreachable */
+  }
+}
+
+/* Push the result table for one replay pass. Conventions follow
+** jit.util.traceir()/tracek(): instruction indexes are 1-based
+** (BASE excluded), constants live at negative indexes -1..-nk
+** (index -i is IR ref REF_BIAS-i), ref operands are REF_BIAS-biased.
+*/
+static void irfuzz_pushpass(lua_State *L, jit_State *J, TRef *map, int n)
+{
+  static const char *const insfields[4] = { "m", "ot", "op1", "op2" };
+  int nins = (int)(J->cur.nins - REF_BIAS - 1);
+  int nk = (int)(REF_BIAS - J->cur.nk);
+  int f, i;
+  lua_createtable(L, 0, 9);
+  lua_pushinteger(L, nins);
+  lua_setfield(L, -2, "nins");
+  lua_pushinteger(L, nk);
+  lua_setfield(L, -2, "nk");
+  for (f = 0; f < 4; f++) {
+    lua_createtable(L, nins, 0);
+    for (i = 1; i <= nins; i++) {
+      IRIns *ir = &J->cur.ir[REF_BIAS + i];
+      int32_t m = lj_ir_mode[ir->o];
+      int32_t v;
+      switch (f) {
+      case 0: v = m; break;
+      case 1: v = ir->ot; break;
+      case 2: v = (int32_t)ir->op1 - (irm_op1(m)==IRMref ? REF_BIAS : 0); break;
+      default: v = (int32_t)ir->op2 - (irm_op2(m)==IRMref ? REF_BIAS : 0);
+      }
+      lua_pushinteger(L, v);
+      lua_rawseti(L, -2, i);
+    }
+    lua_setfield(L, -2, insfields[f]);
+  }
+  lua_createtable(L, nk, 0);
+  for (i = 1; i <= nk; i++) {
+    lua_pushinteger(L, J->cur.ir[REF_BIAS - i].ot);
+    lua_rawseti(L, -2, i);
+  }
+  lua_setfield(L, -2, "kot");
+  lua_createtable(L, nk, 0);
+  for (i = 1; i <= nk; i++) {
+    IRIns *ir = &J->cur.ir[REF_BIAS - i];
+    /* A 64-bit constant keeps its payload in the next slot, and raw
+    ** payload bytes decode as a garbage instruction -- a KPRI of
+    ** collectable type faults the GC barrier below. Skip it. */
+    if ((int32_t)(REF_BIAS - i - 1) >= (int32_t)J->cur.nk &&
+	ir_isk64(&J->cur.ir[REF_BIAS - i - 1])) {
+      lua_pushinteger(L, 0);  /* benign placeholder, keeps kval aligned */
+      lua_rawseti(L, -2, i);
+      continue;
+    }
+    if (ir->o == IR_KSLOT) {
+      /* A KSLOT's op1 must reference another constant in the live
+      ** [nk, REF_BIAS) range. Bounds-check before following it:
+      ** guards against a stale/garbage slot whose op1 points out
+      ** of the buffer (observed crashing irfuzz replays). */
+      if (ir->op1 < (IRRef)J->cur.nk || ir->op1 >= REF_BIAS) {
+        lua_pushinteger(L, 0);  /* benign placeholder, keeps kval aligned */
+        lua_rawseti(L, -2, i);
+        continue;
+      }
+      ir = &J->cur.ir[ir->op1];
+    }
+#if LJ_HASFFI
+    if (ir->o == IR_KINT64 && !ctype_ctsG(G(L))) {
+      ptrdiff_t oldtop = savestack(L, L->top);
+      luaopen_ffi(L);  /* Load FFI library on-demand. */
+      L->top = restorestack(L, oldtop);
+    }
+#endif
+    lua_pushnil(L);
+    lj_ir_kvalue(L, L->top-1, ir);
+    lua_rawseti(L, -2, i);
+  }
+  lua_setfield(L, -2, "kval");
+  lua_createtable(L, n, 0);
+  for (i = 1; i <= n; i++) {
+    lua_pushinteger(L, (int32_t)tref_ref(map[i-1]) - REF_BIAS);
+    lua_rawseti(L, -2, i);
+  }
+  lua_setfield(L, -2, "map");
+}
+
+/* local unopt, opt = jit.util.irfuzz(spec)
+**
+** Replays the synthetic IR instruction stream described by spec through
+** the FOLD engine twice: once with all optimizations disabled and once
+** with JIT_F_OPT_DEFAULT. spec = { n=<count>, op={}, t={}, ak={}, av={},
+** bk={}, bv={} } with per-instruction numeric opcode, IR type byte and
+** operand kind/value pairs (see IRFUZZ_OPND_*).
+*/
+LJLIB_CF(jit_util_irfuzz)
+{
+  jit_State *J = L2J(L);
+  uint32_t origflags = J->flags;
+  int n, pass, i;
+  TRef *map;
+  lj_lib_checktab(L, 1);
+  if (J->state != LJ_TRACE_IDLE)
+    lj_err_callermsg(L, "irfuzz: JIT compiler is not idle");
+  lua_settop(L, 1);
+  lua_getfield(L, 1, "n");
+  n = (int)lua_tointeger(L, -1);
+  lua_pop(L, 1);
+  if (n < 1 || n > 4000)
+    lj_err_callermsg(L, "irfuzz: bad instruction count");
+  lua_getfield(L, 1, "op");  /* Stack indexes 2..7 below. */
+  lua_getfield(L, 1, "t");
+  lua_getfield(L, 1, "ak");
+  lua_getfield(L, 1, "av");
+  lua_getfield(L, 1, "bk");
+  lua_getfield(L, 1, "bv");
+  for (i = 2; i <= 7; i++) {
+    if (!lua_istable(L, i))
+      lj_err_callermsg(L, "irfuzz: missing spec array");
+  }
+  map = (TRef *)lua_newuserdata(L, (size_t)n * sizeof(TRef));
+  for (pass = 0; pass < 2; pass++) {
+    J->L = L;
+    J->flags = (origflags & ~(uint32_t)JIT_F_OPT_MASK) |
+	       (pass ? (uint32_t)JIT_F_OPT_DEFAULT : 0);
+    irfuzz_reset(J);
+    for (i = 1; i <= n; i++) {
+      int32_t op, irt;
+      int ak, bk;
+      TRef a, b;
+      lua_rawgeti(L, 2, i);
+      op = (int32_t)lua_tointeger(L, -1);
+      lua_rawgeti(L, 3, i);
+      irt = (int32_t)lua_tointeger(L, -1);
+      lua_rawgeti(L, 4, i);
+      ak = (int)lua_tointeger(L, -1);
+      lua_rawgeti(L, 6, i);
+      bk = (int)lua_tointeger(L, -1);
+      lua_pop(L, 4);
+      if (op < 0 || op >= (int32_t)IR__MAX || irt < 0 || irt > 0xff) {
+	J->flags = origflags;
+	lj_err_callermsg(L, "irfuzz: bad opcode or type");
+      }
+      a = irfuzz_operand(L, J, map, ak, 5, i);
+      b = irfuzz_operand(L, J, map, bk, 7, i);
+      lj_ir_set(J, ((uint32_t)op << 8) | (uint32_t)irt, a, b);
+      map[i-1] = lj_opt_fold(J);
+    }
+    irfuzz_pushpass(L, J, map, n);
+  }
+  J->flags = origflags;
+  memset(&J->cur, 0, sizeof(GCtrace));
+  return 2;
+}
+
